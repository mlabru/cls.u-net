#
# unt_env.sh.example
#
# modelo do ambiente local lido pelo unt_cron.sh. Copie para unt_env.sh (no
# mesmo diretório; não versionado) e ajuste os caminhos desta máquina -- o
# cron não lê .bashrc/.profile. Só atribuições; o unt_cron.sh exporta tudo.
#
# 2026.out  mlabru  variáveis do treino (unt_treino.sh) e do monitor
# 2026.out  mlabru  portado de 25.oflow (ofl_env.sh.example)
#

# catálogo SQLite e CAPPIs do pipeline do 27.nowcast
#UNT_CATALOG_DB=/home/clsim/Public/nowcast/data/dbase/catalog.db
#UNT_CAPPI_DIR=/home/clsim/Public/nowcast/data/cappi

# raiz dos dados do 25.u-net (logs, output, state, temp, modelos)
#UNT_PATH=/home/clsim/Public/unet

# virtualenv dos backends (padrão ~/.venv, o mesmo do 27.nowcast)
#UNT_VENV=/home/clsim/.venv

# checkpoints treinados (<dir>/<backend>/atual.pt) e device da inferência
#UNT_MODELOS_DIR=/home/clsim/Public/unet/data/modelos
#UNT_DEVICE=auto

# treino (só no host de GPU: "unt_cron.sh treino" -> unt_treino.sh)
#UNT_CONFIG=/caminho/do/repositorio/config.ini
#UNT_TREINO_BACKENDS="pytorch rainnet smaat"
#UNT_TREINO_DEVICE=auto
#UNT_TREINO_ARGS=""
#UNT_TREINO_TIMEOUT_SECS=0
# destino do rsync dos modelos promovidos (UNT_MODELOS_DIR da máquina operacional)
#UNT_DESTINO_MODELOS=clsim@operacional:/home/clsim/Public/unet/data/modelos

# opcionais
#UNT_MONITOR_TIMEOUT_SECS=120
#UNT_AGE_MAX_SECS=7200
#UNT_TIMEOUT_SECS=300
#UNT_DB_TIMEOUT_MS=10000
#UNT_VERIFY=false

# < the end >--------------------------------------------------------------------------
